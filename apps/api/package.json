{
  "name": "@nearly/api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import=tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:vercel": "esbuild src/entri-vercel.ts --bundle --platform=node --format=cjs --target=node22 --outfile=api/index.js --external:@bnb-chain/greenfield-js-sdk --external:@bnb-chain/reed-solomon && node -e \"require('fs').writeFileSync('api/package.json', JSON.stringify({type:'commonjs'})+'\\n')\""
  },
  "dependencies": {
    "@bnb-chain/greenfield-js-sdk": "2.2.2",
    "@bnb-chain/reed-solomon": "1.1.4",
    "@nearly/shared": "workspace:*",
    "@nearly/trust": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0"
  }
}
