# Supabase
SUPABASE_URL=https://xxxx.supabase.co
# Service role key. HANYA di server. Jangan pernah masuk ke bundle mobile.
SUPABASE_SERVICE_ROLE_KEY=

# opBNB testnet (chainId 5611)
OPBNB_TESTNET_RPC=https://opbnb-testnet-rpc.bnbchain.org
CONNECTION_REGISTRY_ADDRESS=
# Kunci privat relayer/attestor. Dompet sekali pakai, isi hanya tBNB testnet.
RELAYER_PRIVATE_KEY=

# ENS hidup di Ethereum mainnet, BUKAN di opBNB.
MAINNET_RPC=https://eth.llamarpc.com

# --- Aplikasi mobile (EXPO_PUBLIC_* ikut terbundel, jangan taruh rahasia asli) ---
# HP tidak bisa menjangkau "localhost" milik laptop. Pakai IP LAN laptop
# (mis. http://192.168.1.5:8787) kalau satu wifi, atau URL tunnel/deploy.
EXPO_PUBLIC_API_URL=http://192.168.1.5:8787
EXPO_PUBLIC_CONNECTION_REGISTRY=
# Dompet sekali pakai berisi tBNB testnet. Simpan lewat EAS secret, bukan di eas.json.
EXPO_PUBLIC_DEV_PRIVATE_KEY=
