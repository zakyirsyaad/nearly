# Supabase
SUPABASE_URL=https://xxxx.supabase.co
# Service role key. HANYA di server. Jangan pernah masuk ke bundle mobile.
SUPABASE_SERVICE_ROLE_KEY=

# BSC testnet (chainId 97)
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
CONNECTION_REGISTRY_ADDRESS=
# Kunci privat relayer/attestor. Dompet sekali pakai, isi hanya tBNB testnet.
RELAYER_PRIVATE_KEY=
VOUCH_REGISTRY_ADDRESS=
TRUST_ATTESTOR_ADDRESS=
NEARLY_RESOLVER_ADDRESS=
# Hasil deploy Fase 3a lewat DeployPhase3a di packages/contracts/script/Deploy.s.sol.
ATTENDANCE_REGISTRY_ADDRESS=
# Alamat attestor yang dipakai script deploy (vm.envAddress). WAJIB sama persis
# dengan alamat milik RELAYER_PRIVATE_KEY — kalau berbeda, setiap createEvent
# dan checkIn revert dengan NotAttestor.
ATTESTOR_ADDRESS=
# Token untuk POST /admin/slash. Acak dan panjang; JANGAN pernah masuk bundle mobile.
ADMIN_TOKEN=
# Alamat yang menjadi seed set. Dipakai alat tools/seed.ts.
SEED_ADDRESS=

# ENS hidup di Ethereum mainnet, BUKAN di opBNB.
MAINNET_RPC=https://eth.llamarpc.com

# --- Aplikasi mobile (EXPO_PUBLIC_* ikut terbundel, jangan taruh rahasia asli) ---
# HP tidak bisa menjangkau "localhost" milik laptop. Pakai IP LAN laptop
# (mis. http://192.168.1.5:8787) kalau satu wifi, atau URL tunnel/deploy.
EXPO_PUBLIC_API_URL=http://192.168.1.5:8787
EXPO_PUBLIC_CONNECTION_REGISTRY=
EXPO_PUBLIC_VOUCH_REGISTRY=
# Alamat AttendanceRegistry yang sama dengan ATTENDANCE_REGISTRY_ADDRESS di atas,
# hasil deploy Fase 3a lewat DeployPhase3a.
EXPO_PUBLIC_ATTENDANCE_REGISTRY=
# Dompet sekali pakai berisi tBNB testnet. Simpan lewat EAS secret, bukan di eas.json.
EXPO_PUBLIC_DEV_PRIVATE_KEY=

# Dipakai alat di apps/api/tools/ saat dijalankan dari laptop.
API_URL=http://localhost:8787
